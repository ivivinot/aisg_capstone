{
  "target": "estimated_lifetime_value",
  "numeric_features": [
    "total_purchase_count",
    "average_order_value",
    "days_since_first_purchase",
    "days_since_last_purchase",
    "product_category_diversity"
  ],
  "categorical_map": {
    "loyalty_program_membership": {
      "Enrolled": 1,
      "Not Enrolled": 0
    }
  },
  "numeric_impute": "median",
  "binary_impute": "most_frequent",
  "binary_fill_value": 0,
  "knn_neighbors": 5,
  "add_missing_indicators": true,
  "recency_policy": "flag",
  "add_quality_flags": false,
  "positivity_floor": 0.001,
  "outlier_strategy": "clip",
  "outlier_quantiles": [
    0.0,
    1.0
  ],
  "outlier_margin": 0.5,
  "log_transform": true,
  "poly_degree": 3,
  "scale": true,
  "drop_constant_features": true,
  "add_derived_features": false,
  "derived_features": "none",
  "feature_selection": "variance",
  "select_k": null,
  "correlation_threshold": 0.999,
  "vif_threshold": 6.0,
  "test_size": 0.2,
  "n_strata": 10,
  "random_state": 42
}